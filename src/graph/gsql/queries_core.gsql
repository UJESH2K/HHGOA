// Entity lookups and behavioural baselines. One installed query per method on GraphBackend.
//
//   gsql -g $GRAPH src/graph/gsql/queries_core.gsql
//
// WHY INSTALLED QUERIES AND NOT GENERATED GSQL. The agent is not handed NL->GSQL in the scoring
// path. Twenty graded cases should not depend on what a model improvises as a query, and two
// backends can only be proven equivalent if both answer a fixed set of questions.
// `generate_gsql` over MCP is excellent for AUTHORING these - and is a good thing to show in the
// demo - but what ships is frozen and named.
//
// EVERY READ IS BOUNDED BY `as_of`. The closed-case backtest replays a finished investigation as
// though it were live, so a query that returns a transaction from after the cutoff invents
// accuracy that will not survive the real twenty.

USE GRAPH $GRAPH

// --------------------------------------------------------------------------------------------
// Entity lookups
// --------------------------------------------------------------------------------------------

CREATE OR REPLACE QUERY get_transaction(STRING txn_id) FOR GRAPH $GRAPH SYNTAX v2 {
  // The flagged transaction and the card it sits on. `risk_score` is read from here and never
  // from the trigger payload: `case_pack.csv` leaves it blank for non-risk-score triggers, and
  // a blank is not "no signal" - the underlying transaction always carries one.
  Txn = {Transaction.*};
  Result = SELECT t FROM Txn:t WHERE t.txn_id == txn_id;
  PRINT Result;
}

CREATE OR REPLACE QUERY get_customer(STRING customer_id) FOR GRAPH $GRAPH SYNTAX v2 {
  SumAccum<INT> @@n_cards;
  SetAccum<STRING> @@card_ids;

  Cust = {Customer.*};
  Start = SELECT c FROM Cust:c WHERE c.customer_id == customer_id;
  Cards = SELECT card FROM Start:c -(OWNS>:e)- PaymentCard:card
          ACCUM @@n_cards += 1, @@card_ids += card.card_id;

  PRINT Start AS customer;
  PRINT Cards AS cards;
  PRINT @@n_cards AS n_cards;
  PRINT @@card_ids AS card_ids;
}

CREATE OR REPLACE QUERY customer_cards(STRING customer_id) FOR GRAPH $GRAPH SYNTAX v2 {
  Cust = {Customer.*};
  Start = SELECT c FROM Cust:c WHERE c.customer_id == customer_id;
  Cards = SELECT card FROM Start -(OWNS>:e)- PaymentCard:card;
  PRINT Cards;
}

CREATE OR REPLACE QUERY card_of_transaction(STRING txn_id) FOR GRAPH $GRAPH SYNTAX v2 {
  // Resolve the card from the transaction, which is the only direction that is always sound.
  // The K-suffix cannot be derived from the card columns - ordering by first-seen, last-seen,
  // volume, minimum id and card1 all fail to reproduce known suffixes - so `card_id` is an
  // anchored attribute and `provenance` says how it was learned.
  Txn = {Transaction.*};
  Start = SELECT t FROM Txn:t WHERE t.txn_id == txn_id;
  Cards = SELECT card FROM Start:t -(USED_BY>:e)- PaymentCard:card;
  PRINT Cards;
}

CREATE OR REPLACE QUERY card_by_id(STRING card_id) FOR GRAPH $GRAPH SYNTAX v2 {
  Cards = {PaymentCard.*};
  Result = SELECT c FROM Cards:c WHERE c.card_id == card_id;
  PRINT Result;
}

// --------------------------------------------------------------------------------------------
// Behaviour
// --------------------------------------------------------------------------------------------

CREATE OR REPLACE QUERY card_history(STRING card_key, DATETIME as_of, INT k, INT days)
  FOR GRAPH $GRAPH SYNTAX v2
{
  // A bounded window of the card's own recent activity, strictly before `as_of`.
  // `days <= 0` means no lower bound. Bounded because the agent reads this, and a 10,332-row
  // history is neither affordable as context nor useful as evidence.
  TYPEDEF TUPLE<STRING txn_id, DATETIME ts, DOUBLE amount, STRING product_cd, STRING channel,
                STRING addr1, DOUBLE risk_score, DOUBLE amt_pctile_prior,
                DOUBLE secs_since_prev> TxnRow;
  HeapAccum<TxnRow>(1000, ts DESC) @@recent;

  Cards = {PaymentCard.*};
  Start = SELECT c FROM Cards:c WHERE c.card_key == card_key;
  Txns = SELECT t FROM Start:c -(USED_IN>:e)- Transaction:t
         WHERE t.ts < as_of AND (days <= 0 OR datetime_diff(as_of, t.ts) <= days * 86400)
         ACCUM @@recent += TxnRow(t.txn_id, t.ts, t.amount, t.product_cd, t.channel,
                                  t.addr1, t.risk_score, t.amt_pctile_prior, t.secs_since_prev);

  PRINT @@recent AS history;
}

CREATE OR REPLACE QUERY card_baseline(STRING card_key, STRING txn_id)
  FOR GRAPH $GRAPH SYNTAX v2
{
  // Where this transaction sits in its card's OWN prior distribution.
  //
  // The percentile itself is read from the Transaction attribute, not computed here - it is an
  // expanding (as-of) rank built at load time, which is both cheaper and safer: computing it at
  // query time over the card's whole history would include transactions after this one and score
  // a case using its own future. What this query adds is the CONTEXT the attribute cannot carry:
  // which regions and product codes the card had used before this moment, so "a region this card
  // has never used" can be stated with the list behind it.
  SumAccum<INT> @@n_prior;
  SetAccum<STRING> @@known_regions;
  SetAccum<STRING> @@known_products;
  DOUBLE flagged_ts_secs;

  Txn = {Transaction.*};
  Flagged = SELECT t FROM Txn:t WHERE t.txn_id == txn_id
            ACCUM flagged_ts_secs = datetime_to_epoch(t.ts);

  Cards = {PaymentCard.*};
  Start = SELECT c FROM Cards:c WHERE c.card_key == card_key;
  Prior = SELECT t FROM Start:c -(USED_IN>:e)- Transaction:t
          WHERE datetime_to_epoch(t.ts) < flagged_ts_secs
          ACCUM @@n_prior += 1,
                CASE WHEN t.addr1 != "" THEN @@known_regions += t.addr1 END,
                @@known_products += t.product_cd;

  PRINT Flagged AS flagged;
  PRINT @@n_prior AS n_prior_txns;
  PRINT @@known_regions AS known_regions;
  PRINT @@known_products AS known_products;
}

CREATE OR REPLACE QUERY same_amount_priors(STRING card_key, STRING txn_id, DOUBLE tolerance)
  FOR GRAPH $GRAPH SYNTAX v2
{
  // Candidate charges for the recurring-charge detector: same card, same product code, amount
  // within `tolerance`, strictly earlier.
  //
  // DELIBERATE SPLIT OF LABOUR. The graph does the retrieval, which is what a graph is good at;
  // the cadence arithmetic - median interval, coefficient of variation, whether the flagged
  // charge lands on cycle - runs in `features/recurring.py` over these rows. Expressing a
  // regularity test in GSQL accumulators would be a party trick with a worse failure mode, and
  // the same Python code then serves both backends, which is what makes the contract test able
  // to prove they agree.
  TYPEDEF TUPLE<STRING txn_id, DATETIME ts, DOUBLE amount, STRING product_cd,
                STRING p_emaildomain> PriorRow;
  ListAccum<PriorRow> @@priors;
  DOUBLE flagged_amount;
  DOUBLE flagged_ts_secs;
  STRING flagged_product;

  Txn = {Transaction.*};
  Flagged = SELECT t FROM Txn:t WHERE t.txn_id == txn_id
            ACCUM flagged_amount = t.amount,
                  flagged_ts_secs = datetime_to_epoch(t.ts),
                  flagged_product = t.product_cd;

  Cards = {PaymentCard.*};
  Start = SELECT c FROM Cards:c WHERE c.card_key == card_key;
  Prior = SELECT t FROM Start:c -(USED_IN>:e)- Transaction:t
          WHERE datetime_to_epoch(t.ts) < flagged_ts_secs
            AND t.product_cd == flagged_product
            AND abs(t.amount - flagged_amount) <= tolerance
          ACCUM @@priors += PriorRow(t.txn_id, t.ts, t.amount, t.product_cd, t.p_emaildomain);

  PRINT Flagged AS flagged;
  PRINT @@priors AS priors;
}

CREATE OR REPLACE QUERY device_for_transaction(STRING txn_id) FOR GRAPH $GRAPH SYNTAX v2 {
  // The device profile behind an online transaction, with the two attributes the ring filter
  // needs. An empty result is the normal answer for card-present activity: not one of the
  // 439,670 in-person transactions in the book has a device record, so absence is not a signal.
  // The device state and proxy live on the EDGE (they are properties of this transaction's
  // session, not of the profile), so the row is assembled from both ends rather than printed
  // from the vertex set.
  TYPEDEF TUPLE<STRING device_profile, BOOL is_full, INT global_card_count,
                INT global_customer_count, STRING device_state, STRING proxy_kind> DeviceRow;
  ListAccum<DeviceRow> @@device;

  Txn = {Transaction.*};
  Start = SELECT t FROM Txn:t WHERE t.txn_id == txn_id;
  Devices = SELECT d FROM Start:t -(ON_DEVICE>:e)- DeviceProfile:d
            ACCUM @@device += DeviceRow(d.device_profile, d.is_full, d.global_card_count,
                                        d.global_customer_count, e.device_state, e.proxy_kind);

  PRINT @@device AS device;
}

CREATE OR REPLACE QUERY card_testing_window(STRING card_key, DATETIME as_of, DOUBLE small_amount,
                                 INT lookback_days)
  FOR GRAPH $GRAPH SYNTAX v2
{
  // Policy R5's raw material: small ONLINE authorisations on this card shortly before `as_of`,
  // plus anything larger that cleared afterwards. The sliding-hour window and the "three or more"
  // test run in `features/testing.py` over these rows, for the same reason as
  // `same_amount_priors` - one implementation of the rule, shared by both backends.
  //
  // Expect this to return nothing almost always. Under the literal R5 reading, 28 cards in the
  // entire 590,742-row book qualify, and none of the twenty exam cases has a qualifying sequence
  // at its flagged moment. The query is here because it is exact and nearly free, not because it
  // is expected to fire.
  TYPEDEF TUPLE<STRING txn_id, DATETIME ts, DOUBLE amount, STRING channel> BurstRow;
  ListAccum<BurstRow> @@small;
  ListAccum<BurstRow> @@larger;

  Cards = {PaymentCard.*};
  Start = SELECT c FROM Cards:c WHERE c.card_key == card_key;
  Window = SELECT t FROM Start:c -(USED_IN>:e)- Transaction:t
           WHERE t.ts < as_of
             AND datetime_diff(as_of, t.ts) <= lookback_days * 86400
             AND t.channel == "online"
           ACCUM CASE WHEN t.amount < small_amount
                      THEN @@small += BurstRow(t.txn_id, t.ts, t.amount, t.channel)
                      ELSE @@larger += BurstRow(t.txn_id, t.ts, t.amount, t.channel) END;

  PRINT @@small AS small_txns;
  PRINT @@larger AS larger_txns;
}

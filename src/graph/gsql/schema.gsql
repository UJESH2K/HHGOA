// Schema for the $GRAPH graph.
//
//   gsql -g $GRAPH src/graph/gsql/schema.gsql
//   (or: python -m src.graph.deploy --schema, which runs this through pyTigerGraph)
//
// WHAT THE SHAPE IS FOR. Every vertex and edge here exists because a query in
// `src/graph/interface.py` needs it. Nothing is modelled for completeness: the 397 columns of
// `transactions.csv` are not in the graph, because nothing in the investigation loop reads the
// V/C/D/M blocks except as honest "unnamed Vesta model feature" corroboration, and 590,742
// vertices carrying 397 attributes each would not fit a free-tier workspace.
//
// THE THREE THINGS PRECOMPUTED AT LOAD TIME, and why they are attributes rather than queries:
//
//   `Transaction.amt_pctile_prior`  where this amount sits in the card's OWN prior distribution.
//                                   The single highest-value feature in the build. As an
//                                   attribute it is one property read; as a query it is a scan of
//                                   the card's full history, which for C11923 is 10,332 rows.
//   `Transaction.next_txn_id`       the NEXT_TXN chain, so burst and sequence evidence is one hop.
//   `DeviceProfile.global_card_count` + `is_full`
//                                   the ring filter's two conditions, so filtering a candidate is
//                                   a property lookup and not a subquery. This is what turns
//                                   1,671 naive Nov-Dec candidates into 266.
//
// AS-OF DISCIPLINE. Timestamps are stored as DATETIME on both Transaction and ClosedCase so that
// every query can bound itself with `WHERE ts < as_of`. A query that leaks post-cutoff rows
// inflates the closed-case backtest and teaches us nothing about the twenty.

// VERTEX AND EDGE TYPES ARE DATABASE-GLOBAL IN TIGERGRAPH, NOT GRAPH-LOCAL.
//
// That is not a detail - it decided the shape of this file. This workspace already hosts
// TigerGraph's sample `Transaction_Fraud` graph, whose 18 vertex types include one called
// `Card`. A global `CREATE VERTEX Card` would have collided with it, so ours is `PaymentCard`
// (the better name regardless - these are payment instruments). Every other type we define was
// checked against the 18 vertex and 22 edge types already in the database: no other collision.
//
// So the types are declared globally first and the graph is assembled from them at the end,
// which is the documented order and avoids the local-versus-global ambiguity entirely. We add a
// graph to the database; we do not touch the sample graph.

// --------------------------------------------------------------------------------------------
// Vertices
// --------------------------------------------------------------------------------------------

CREATE VERTEX Customer (
  PRIMARY_ID customer_id STRING,
  n_cards INT,
  n_txns INT,
  first_seen DATETIME,
  last_seen DATETIME
) WITH primary_id_as_attribute="true"

// `card_id` is RECONSTRUCTED, not given: transactions.csv has no card column. The key is
// (customer_id, card1..card6) and the K-suffix is anchored from the case files - it is not
// derivable from the card columns. `provenance` records which mechanism named this card, and a
// card with provenance "unknown" must never be cited by id in an answer file.
CREATE VERTEX PaymentCard (
  PRIMARY_ID card_key STRING,
  card_id STRING,
  customer_id STRING,
  provenance STRING,          // anchored | inferred_single_card | unknown
  n_txns INT,
  network STRING,             // card4
  card_type STRING            // card6
) WITH primary_id_as_attribute="true"

CREATE VERTEX Transaction (
  PRIMARY_ID txn_id STRING,
  ts DATETIME,
  amount DOUBLE,
  product_cd STRING,
  channel STRING,             // online | in_person - a restatement of product_cd == "W"
  risk_score DOUBLE,          // the bank's model. An INPUT, not a label
  addr1 STRING,               // billing region, NULL on 94.8% of C-product rows
  p_emaildomain STRING,
  card_key STRING,
  customer_id STRING,
  // precomputed, as-of by construction (see the header)
  amt_pctile_prior DOUBLE,
  amt_mean_prior DOUBLE,
  amt_max_prior DOUBLE,
  new_region BOOL,
  new_product BOOL,
  prior_txns_1h INT,
  prior_txns_24h INT,
  secs_since_prev DOUBLE,
  txn_seq INT,
  next_txn_id STRING
) WITH primary_id_as_attribute="true"

// `DeviceInfo | OS | browser | screen`. Carries the ring filter's own thresholds as attributes -
// see the header. 4,793 of 9,706 profiles span more than one card, and the largest is 1,023
// cards' worth of all-null fields, so "shared profile" means nothing without `is_full` and
// `global_card_count`.
CREATE VERTEX DeviceProfile (
  PRIMARY_ID device_profile STRING,
  is_full BOOL,
  global_card_count INT,
  global_customer_count INT,
  n_txns INT,
  first_seen DATETIME,
  last_seen DATETIME
) WITH primary_id_as_attribute="true"

CREATE VERTEX BillingRegion (PRIMARY_ID addr1 STRING, n_txns INT)
  WITH primary_id_as_attribute="true"

CREATE VERTEX EmailDomain (PRIMARY_ID domain STRING, n_txns INT)
  WITH primary_id_as_attribute="true"

// The labelled history, and the agent's starting case memory. 5,565 rows, 83.8% confirmed fraud -
// which is a filtered population of alerts someone already thought worth opening, NOT a base
// rate. `summary_embedding` holds the analyst notes embedded verbatim.
CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,
  customer_id STRING,
  card_id STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  outcome STRING,             // confirmed_fraud | cleared
  pattern STRING,
  exposure_usd DOUBLE,
  n_txns INT,
  actions_taken STRING,
  report_filed STRING,
  channel STRING,             // derived from the anchor transaction; the CSV has no channel
  product_cd STRING,
  analyst_notes STRING,
  summary_embedding LIST<DOUBLE>
) WITH primary_id_as_attribute="true"

// The live case this agent creates and progresses. Written during the investigation, not at the
// end: `status`, `fraud_probability` and `actions` are updated as evidence accrues, which is what
// makes case progression visible as a subgraph rather than as a JSON blob.
CREATE VERTEX FraudCase (
  PRIMARY_ID graph_case_id STRING,
  case_id STRING,
  customer_id STRING,
  card_id STRING,
  opened_at DATETIME,
  updated_at DATETIME,
  status STRING,              // open | closed_fraud | closed_legitimate | escalated
  verdict STRING,             // fraud | legitimate | uncertain
  fraud_probability DOUBLE,
  pattern STRING,
  exposure_usd DOUBLE,
  stop_reason STRING,
  summary STRING,
  actions STRING,             // pipe-joined, mirroring closed_cases_history.actions_taken
  evidence_json STRING,       // the full evidence list, for the UI and the audit trail
  decisions_json STRING,
  summary_embedding LIST<DOUBLE>
) WITH primary_id_as_attribute="true"

// Fraud policy, the five documented typologies, FinCEN narrative guidance, and any typology the
// community-detection pass discovers. This is the GraphRAG corpus.
CREATE VERTEX PolicyChunk (
  PRIMARY_ID chunk_id STRING,
  doc STRING,                 // fraud_policy | typology | regulation | discovered_typology
  section STRING,
  title STRING,
  body STRING,
  embedding LIST<DOUBLE>
) WITH primary_id_as_attribute="true"

// --------------------------------------------------------------------------------------------
// Edges
// --------------------------------------------------------------------------------------------

CREATE DIRECTED EDGE OWNS (FROM Customer, TO PaymentCard) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE USED_IN (FROM PaymentCard, TO Transaction) WITH REVERSE_EDGE="USED_BY"

// Ordered by ts within a card. Built at load time, not sorted at query time: this is what makes
// the card-testing and burst patterns reachable in one hop instead of a full-history scan.
CREATE DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction, secs_gap DOUBLE)
  WITH REVERSE_EDGE="PREV"

CREATE DIRECTED EDGE ON_DEVICE (FROM Transaction, TO DeviceProfile, device_state STRING,
                                proxy_kind STRING) WITH REVERSE_EDGE="DEVICE_USED_BY"
CREATE DIRECTED EDGE BILLED_TO (FROM Transaction, TO BillingRegion)
  WITH REVERSE_EDGE="BILLS"
CREATE DIRECTED EDGE FROM_DOMAIN (FROM Transaction, TO EmailDomain)
  WITH REVERSE_EDGE="DOMAIN_OF"

// DERIVED AND FILTERED, never "these two cards share a value". Written only for profile pairs
// that survive `features/rings.is_specific` - full profile, <= 10 global cards - so the edge
// set itself encodes the calibration. Running Connected Components over an unfiltered version
// of this edge would return a single component containing half the book.
CREATE UNDIRECTED EDGE SHARES_DEVICE (FROM PaymentCard, TO PaymentCard, device_profile STRING,
                                      first_ts DATETIME, last_ts DATETIME, span_days DOUBLE,
                                      n_customers INT)

CREATE DIRECTED EDGE HAS_CASE (FROM Customer, TO ClosedCase) WITH REVERSE_EDGE="CASE_OF"
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN"
CREATE DIRECTED EDGE CASE_ON_CARD (FROM ClosedCase, TO PaymentCard) WITH REVERSE_EDGE="CARD_IN_CASE"

// The live case's own edges. `SIMILAR_TO` is written only for prior cases the investigation
// ACTUALLY used in its reasoning, not for everything retrieval returned - `similar_prior_cases`
// is a scored field and padding it with template-similar noise manufactures false confidence.
CREATE DIRECTED EDGE ABOUT (FROM FraudCase, TO Customer) WITH REVERSE_EDGE="SUBJECT_OF"
CREATE DIRECTED EDGE CASE_CARD (FROM FraudCase, TO PaymentCard) WITH REVERSE_EDGE="CARD_OF_CASE"
CREATE DIRECTED EDGE TRIGGERED_BY (FROM FraudCase, TO Transaction) WITH REVERSE_EDGE="TRIGGERED"
CREATE DIRECTED EDGE EVIDENCED_BY (FROM FraudCase, TO Transaction, claim STRING, stage STRING)
  WITH REVERSE_EDGE="EVIDENCE_FOR"
CREATE DIRECTED EDGE SIMILAR_TO (FROM FraudCase, TO ClosedCase, score DOUBLE, basis STRING)
  WITH REVERSE_EDGE="SIMILAR_FROM"
CREATE DIRECTED EDGE CITES (FROM FraudCase, TO PolicyChunk, rule STRING)
  WITH REVERSE_EDGE="CITED_BY"

// --------------------------------------------------------------------------------------------
// The graph: assembled from the global types above. Additive - the sample graph is untouched.
// --------------------------------------------------------------------------------------------

CREATE GRAPH $GRAPH (
  Customer, PaymentCard, Transaction, DeviceProfile, BillingRegion, EmailDomain, ClosedCase, FraudCase, PolicyChunk,
  OWNS, USED_IN, NEXT_TXN, ON_DEVICE, BILLED_TO, FROM_DOMAIN, SHARES_DEVICE, HAS_CASE, INVOLVES, CASE_ON_CARD, ABOUT, CASE_CARD, TRIGGERED_BY, EVIDENCED_BY, SIMILAR_TO, CITES
)

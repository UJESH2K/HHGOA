# Copy to `.env` and fill in. `.env` is gitignored.

# --- LLM (required for the agent loop, Phase 2) ---
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-5              # the 20 graded runs; ~$3 for the pack
AGENT_MODEL_CHEAP=claude-haiku-4-5    # backtest sweeps and bulk summarisation

# --- TigerGraph (required for Phase 1; the local parquet backend works without it) ---
# Savanna: https://savanna.tgcloud.io   |   CE: https://dl.tigergraph.com
TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPH=FraudInvestigation
TG_USERNAME=tigergraph
TG_PASSWORD=
TG_SECRET=                                # or use a secret instead of username/password

# --- Embeddings (Phase 0b vector store; skip to run without GraphRAG) ---
VOYAGE_API_KEY=

# --- Optional tracing ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hhgoa-fraud
LANGCHAIN_TRACING_V2=true
